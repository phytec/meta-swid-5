From 7a4486881627026e57e8a6c5a139b54539836da8 Mon Sep 17 00:00:00 2001
From: Nicolas Raimundo <n.raimundo@phytec.fr>
Date: Fri, 22 Nov 2024 11:10:17 +0100
Subject: [PATCH 2/2] undo net: fec_mxc: Remove clk_ref rate multiplication

---
 drivers/net/fec_mxc.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/net/fec_mxc.c b/drivers/net/fec_mxc.c
index b33326ff3fa..8a866ca8b79 100644
--- a/drivers/net/fec_mxc.c
+++ b/drivers/net/fec_mxc.c
@@ -1218,6 +1218,9 @@ static int fecmxc_set_ref_clk(struct clk *clk_ref, phy_interface_t interface)
 	else
 		return -EINVAL;
 
+	if (is_imx93() || is_imx91())
+		freq = freq << 1;
+
 	ret = clk_set_rate(clk_ref, freq);
 	if (ret < 0)
 		return ret;
